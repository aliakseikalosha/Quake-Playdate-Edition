{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Playdate: configure (simulator, debug)",
			"type": "shell",
			"command": "cmake -S . -B build-sim-debug -DBOARD_NAME=playdate -DCMAKE_BUILD_TYPE=Debug",
			"problemMatcher": []
		},
		{
			"label": "Playdate: build (simulator, debug)",
			"type": "shell",
			"command": "touch port/boards/playdate/main.c && cmake --build build-sim-debug -j 8",
			"dependsOn": "Playdate: configure (simulator, debug)",
			"problemMatcher": ["$gcc"],
			"group": { "kind": "build", "isDefault": true }
		},
		{
			"label": "Playdate: clean (simulator)",
			"type": "shell",
			// Build trees (they hold quake.pdx) plus the pdex library that the
			// simulator build copies into Source/. Device outputs are untouched.
			"command": "rm -rf build-sim build-sim-debug port/boards/playdate/Source/pdex.dylib port/boards/playdate/Source/pdex.so port/boards/playdate/Source/pdex.dll",
			"problemMatcher": []
		},
		{
			"label": "Playdate: build (device)",
			"type": "shell",
			"command": "cmake -S . -B build-dev -DCMAKE_TOOLCHAIN_FILE=port/boards/playdate/toolchain.cmake -DBOARD_NAME=playdate && cmake --build build-dev -j 8",
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Playdate: clean build (device)",
			"type": "shell",
			// Remove the build tree and the stale pdex.* binaries that pdc would
			// otherwise bundle into the .pdx, then rebuild from scratch.
			"command": "rm -rf build-dev port/boards/playdate/Source/pdex.* && cmake -S . -B build-dev -DCMAKE_TOOLCHAIN_FILE=port/boards/playdate/toolchain.cmake -DBOARD_NAME=playdate && cmake --build build-dev -j 8",
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Playdate: release build (device)",
			"type": "shell",
			// Clean Release build of the full game, build-release-full/Quake-<version>-full.pdx and .zip (no profiler): pak0.pak,
			// music and mods as they are in Source/. New build number, written to Source/pdxinfo.
			"command": "./scripts/release-device.sh full",
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Playdate: demo build (device)",
			"type": "shell",
			// Clean Release build of the shareware, build-release/Quake-<version>-demo.pdx and .zip (no profiler): pak0_demo.pak as
			// id1/pak0.pak, no music, no mods except the qpe mod's shareware part. New build number, written to Source/pdxinfo.
			"command": "./scripts/release-device.sh demo",
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Playdate: clean all builds",
			"type": "shell",
			// Every build tree (build/, build-*/: Simulator, device, release outputs and their .pdx/.zip) and the pdex.*
			// binaries a build leaves in Source/ (pdc would bundle them). Source/'s game data is untouched.
			"command": "rm -rf build build-*/ port/boards/playdate/Source/pdex.*",
			"problemMatcher": []
		},
		{
			"label": "Playdate: clean all, release full and demo",
			// Clean all builds, then the full release and the shareware demo release, one after the other (each gets a
			// new build number; a failure stops the rest): build-release-full/ and build-release/.
			"dependsOn": ["Playdate: clean all builds", "Playdate: release build (device)", "Playdate: demo build (device)"],
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "qpe: build patch",
			"type": "shell",
			// Rebuild the qpe mod from mods/qpe/art (Source/qpe/), then make mods/qpe/qpe.qpatch: the mod without id's
			// data, which tools/qpe/qpepatch.py applies to anyone's paks (docs/port/qpe.md). Needs Source/id1's paks.
			"command": "python3 tools/qpe/qpe.py patch",
			"problemMatcher": []
		},
		{
			"label": "Install on device (USB)",
			"type": "shell",
			"dependsOn": "Playdate: clean build (device)",
			"command": "./scripts/install-device.sh",
			"problemMatcher": []
		}
	]
}
